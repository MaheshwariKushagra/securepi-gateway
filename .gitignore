# Never commit credentials or key material.
*.pem
*.key
*.p12
*.crt
*.cer
.env
secrets/
*-password*
*.token

# mitmproxy CA material, in case anything is ever copied locally
ca/
mitmproxy-*

# Captured traffic and debug dumps - may contain personal data
*.pcap
*.flow
*-sample.json
querylog*

# OS noise
.DS_Store

# Demo console build artefacts (docs/demo/)
docs/demo/securepi.db*
docs/demo/orchestrator.lock
docs/demo/dpi-rule-stats.json
docs/demo/node_modules/
docs/demo/package*.json
docs/demo/*.log

# Python bytecode
__pycache__/
*.pyc

# Step 7.1 replay inputs: the ET Open ruleset copied from the gateway and
# third-party captures (CTU-13) - never pushed. eval/results/ is committed.
eval/pcaps/
eval/rules/
eval/replay-out/
