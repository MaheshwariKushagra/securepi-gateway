# AdGuard Home configuration for SecurePi Gateway (gateway/install.sh writes it
# to /opt/AdGuardHome/AdGuardHome.yaml, mode 600, ONLY if that file does not
# exist yet - an existing configuration is never overwritten).
#
# Taken from the live gateway on 10 October 2026 (AdGuard Home v0.107.79,
# schema_version 34) with two changes: the admin password hash is a
# placeholder the installer fills in (bcrypt, `htpasswd -B -C 10`), and the
# per-device persistent clients are empty (the orchestrator creates them at
# run time from the console's policies).
#
# What matters for the rest of the system, and must not be changed without
# changing the code that depends on it:
#   http.address 127.0.0.1:3000 and users[0].name securepi  -> app/adguard.py
#   dns.bind_hosts [10.10.0.1], port 53                     -> nftables DNAT, DHCP, dns_failopen.py
#   dhcp.interface_name ap0, range 10.10.0.50-150            -> registry.py reads data/leases.json
#   querylog enabled + file_enabled                          -> ingest.py (API, file fallback)
#   the filter http://127.0.0.1:8082/ioc-domains.txt         -> intel.py writes it, securepi-static serves it
http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  address: 127.0.0.1:3000
  session_ttl: 30d
users:
  - name: securepi
    password: ADGUARD_PASSWORD_HASH_PLACEHOLDER
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - 10.10.0.1
  port: 53
  anonymize_client_ip: false
  ratelimit: 0
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
    - tls://1.1.1.1
    - tls://9.9.9.9
  upstream_dns_file: ""
  bootstrap_dns:
    - 1.1.1.1
    - 9.9.9.9
  fallback_dns:
    - tls://1.0.0.1
    - tls://149.112.112.112
  upstream_mode: parallel
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: true
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true
tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false
querylog:
  dir_path: ""
  ignored: []
  interval: 30d
  size_memory: 1000
  enabled: true
  ignored_enabled: false
  file_enabled: true
statistics:
  dir_path: ""
  ignored: []
  interval: 30d
  enabled: true
  ignored_enabled: false
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: false
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt
    name: HaGeZi Pro
    id: 1789173079
  - enabled: false
    url: https://big.oisd.nl/
    name: OISD Big
    id: 1789173080
  - enabled: true
    url: https://pgl.yoyo.org/adservers/serverlist.php?hostformat=adblockplus&showintro=1&mimetype=plaintext
    name: Peter Lowe List
    id: 1789173081
  - enabled: true
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/doh.txt
    name: HaGeZi Encrypted DNS Bypass (DoH)
    id: 1789385985
  - enabled: false
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/doh-vpn-proxy-bypass.txt
    name: HaGeZi DoH/VPN/Proxy Bypass
    id: 1789385986
  - enabled: true
    url: http://127.0.0.1:8082/ioc-domains.txt
    name: Offline Threat Intel (abuse.ch, via SecurePi)
    id: 1789385987
whitelist_filters: []
user_rules:
  - '||use-application-dns.net^$dnsrewrite=NXDOMAIN'
  - '||mask.icloud.com^$dnsrewrite=NXDOMAIN'
  - '||mask-h2.icloud.com^$dnsrewrite=NXDOMAIN'
dhcp:
  enabled: true
  interface_name: ap0
  local_domain_name: securepi
  dhcpv4:
    gateway_ip: 10.10.0.1
    subnet_mask: 255.255.255.0
    range_start: 10.10.0.50
    range_end: 10.10.0.150
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: Local
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites: []
  safe_fs_patterns: []
  max_http_size: 256MB
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: 34
