#!/bin/bash
# securepi - status and control for the SecurePi Gateway.
#
#   securepi status              full health check - every always-on
#                                 service, network state, and anything that
#                                 needs manual attention after a reboot
#   securepi devices             list devices on the project network
#   securepi enroll [ip|all]     turn ON HTTPS inspection (default: all leases)
#   securepi unenroll [ip|all]   turn it OFF
#
# The service list checked by `status` lives in /opt/securepi/services.list,
# not hardcoded here - add a new always-on service there and it is checked
# everywhere without editing this script.
#
# HTTPS inspection (Tier 2 ad blocking) is deliberately OFF after every
# reboot - it decrypts traffic, so it should be switched on consciously
# rather than persisting silently. `status` calls this out explicitly rather
# than burying it in a general services list, because forgetting to
# re-enroll after a reboot looks exactly like "the ad blocker broke" from the
# outside, when nothing did.

LEASES=/opt/AdGuardHome/data/leases.json
SERVICES_LIST=/opt/securepi/services.list

leased_ips() {
    python3 -c "
import json
try:
    for l in json.load(open('$LEASES'))['leases']:
        print(l['ip'])
except Exception:
    pass
"
}

enrolled_ips() {
    nft list set ip nat enrolled 2>/dev/null \
        | grep -oP 'elements = \{ \K[^}]*' | tr -d ' ' | tr ',' '\n' | grep -v '^$'
}

service_list() {
    if [ -f "$SERVICES_LIST" ]; then
        grep -vE '^\s*(#|$)' "$SERVICES_LIST"
    else
        # Fallback if the list file is ever missing - better a stale hardcoded
        # set than a status check that silently checks nothing.
        echo "hostapd securepi-ap0 AdGuardHome nftables securepi-dpi securepi-ca-server" | tr ' ' '\n'
    fi
}

case "${1:-status}" in

  status)
    echo "== SecurePi Gateway =="
    echo "uptime: $(uptime -p)"
    echo
    echo "services:"
    all_ok=1
    while read -r s; do
        [ -z "$s" ] && continue
        state="$(systemctl is-active "$s" 2>/dev/null)"
        printf "   %-22s %s\n" "$s" "$state"
        [ "$state" != "active" ] && all_ok=0
    done < <(service_list)
    if [ "$all_ok" = "1" ]; then
        echo "   -> all services active"
    else
        echo "   -> ** ONE OR MORE SERVICES ARE NOT ACTIVE - see above **"
    fi
    echo
    echo "network:"
    printf "   WAN   %-18s %s %s\n" "$(ip -br -4 addr show wlp2s0 | awk '{print $3}')" \
        "$(iw dev wlp2s0 link | grep -oP 'SSID: \K.*')" "$(iw dev wlp2s0 link | grep -oP 'signal: \K.*')"
    printf "   AP    %-18s SecurePi-Test, %s client(s)\n" \
        "$(ip -br -4 addr show ap0 | awk '{print $3}')" "$(iw dev ap0 station dump | grep -c ^Station)"
    printf "   MGMT  %-18s\n" "$(ip -br -4 addr show enp1s0 | awk '{print $3}')"
    printf "   internet: %s\n" "$(ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && echo ok || echo FAIL)"
    echo
    echo "filtering:"
    printf "   Tier 1 (DNS filtering):     %s\n" "$(dig +short +time=2 doubleclick.net @10.10.0.1 2>/dev/null | grep -q 0.0.0.0 && echo "active" || echo "** NOT BLOCKING - check AdGuardHome **")"
    e=$(enrolled_ips | tr '\n' ' ')
    if [ -n "$e" ]; then
        printf "   Tier 2 (HTTPS inspection):  ON  (%s)\n" "$e"
    else
        printf "   Tier 2 (HTTPS inspection):  OFF -- this is EXPECTED after a reboot.\n"
        echo "      If you want YouTube ad removal active this session, run:"
        echo "         sudo securepi enroll all"
    fi
    echo
    echo "test harness (for signal testing, day 14 evaluation):"
    printf "   %s\n" "$(ip link show br-test >/dev/null 2>&1 && echo "present" || echo "** MISSING - check securepi-test-harness.service **")"
    echo
    printf "power: %s, battery %s%%\n" \
        "$([ "$(cat /sys/class/power_supply/AC/online)" = 1 ] && echo 'plugged in' || echo 'ON BATTERY')" \
        "$(cat /sys/class/power_supply/BAT0/capacity)"
    ;;

  devices)
    echo "Devices on the project network:"
    enrolled=$(enrolled_ips | tr '\n' ' ')
    python3 -c "
import json
try:
    leases = json.load(open('$LEASES'))['leases']
except Exception:
    leases = []
if not leases:
    print('   none yet - connect a device to SecurePi-Test')
for l in leases:
    tag = 'INSPECTED' if l['ip'] in '''$enrolled'''.split() else ''
    print('   %-13s %-18s %-22s %s' % (l['ip'], l['mac'], l['hostname'], tag))
"
    ;;

  enroll|unenroll)
    target="${2:-all}"
    if [ "$target" = "all" ]; then
        ips=$(leased_ips)
        [ -z "$ips" ] && { echo "No devices have a lease yet - connect them first."; exit 1; }
    else
        ips="$target"
    fi
    for ip in $ips; do
        if [ "$1" = "enroll" ]; then
            nft add element ip nat enrolled "{ $ip }" 2>/dev/null && echo "   inspection ON  $ip"
        else
            nft delete element ip nat enrolled "{ $ip }" 2>/dev/null && echo "   inspection OFF $ip" \
                || echo "   (not enrolled)  $ip"
        fi
    done
    ;;

  *)
    echo "usage: securepi [status|devices|enroll [ip|all]|unenroll [ip|all]]"
    ;;
esac
