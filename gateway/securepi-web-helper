#!/usr/bin/env python3
"""
SecurePi Gateway - privileged helper for the web console
(ENHANCEMENT-PLAN.md step 3.3, "unprivileged web app + allowlisted root
helper for quarantine, block, enroll/unenroll", finding G9).

Runs as root, invoked by the unprivileged `securepi-web` service through
a narrow sudoers NOPASSWD rule (gateway/securepi-web-sudoers) that allows
running ONLY this one program. This is the only thing on the gateway
that runs `nft` on the web console's behalf - app/quarantine.py and
app/dpi_enroll.py no longer call `nft` directly; they call this instead,
through exactly the same subprocess-with-a-list shape they already used
(never a shell, never string interpolation into a shell command), and
keep their own idempotency/error-string logic unchanged, since this
helper passes nft's real stdout/stderr/exit code straight back through.

sudoers only decides WHICH PROGRAM may run as root - it does not (and
should not be relied on to) understand what a "valid IP" or "a sane
timeout" looks like. That is this script's own job: every verb below
validates its arguments before touching nftables at all, and refuses
anything that doesn't parse as exactly what it claims to be. This is
deliberately NOT a general-purpose nft wrapper - it hardcodes the
family/table/set for each verb, so nothing this console asks for can
touch a different part of the ruleset than the one operation it's
allowlisted for.

Verbs (each maps to exactly one nft invocation):
  quarantine-add <ip>          add <ip> to inet filter quarantine
  quarantine-delete <ip>       remove <ip> from inet filter quarantine
  quarantine-list              list inet filter quarantine (JSON, as nft -j prints it)
  enrolled-add <ip> <hours>    add <ip> to ip nat enrolled, with a fresh timeout
  enrolled-delete <ip>         remove <ip> from ip nat enrolled
  enrolled-list                list ip nat enrolled (JSON)
  enrolled-flush               remove every element from ip nat enrolled

Added in ENHANCEMENT-PLAN.md step 4.2 (MAC-keyed, timed quarantine and
"block this IP" from an incident), both called by app/orchestrator.py:
  quarantine-mac-add <mac> [seconds]  add <mac> to inet filter quarantine_mac,
                                      optionally with a kernel-side expiry
  quarantine-mac-delete <mac>         remove <mac> from inet filter quarantine_mac
  quarantine-mac-list                 list inet filter quarantine_mac (JSON)
  blocked-ip-add <ip> [seconds]       add <ip> to inet filter blocked_ip,
                                      optionally with a kernel-side expiry
  blocked-ip-delete <ip>              remove <ip> from inet filter blocked_ip
  blocked-ip-list                     list inet filter blocked_ip (JSON)

Added by ADBLOCK-ENHANCEMENT-PLAN.md (making an enrolment or site change
apply at once, not only to connections opened afterwards). These run
conntrack and ss, never nft, with fixed paths and a validated address:
  https-reset <ip>             delete the connection-tracking entries of
                               <ip>'s HTTPS (TCP 443) connections and close
                               its connections to the inspection proxy
                               (:8080), so its browser reconnects under the
                               new decision
  https-reset-all              close every connection to the inspection
                               proxy (the privacy fail-safe, after a flush)

Every call that changes something, and every rejected call, is logged
to the system journal via syslog (auth facility) - read-only *-list
calls are not (see main()),
independent of and in addition to the web app's own audit_log table -
this is the half of the audit trail that exists even if the database
itself were somehow bypassed.
"""

import ipaddress
import re
import subprocess
import sys
import syslog

NFT = "/usr/sbin/nft"
CONNTRACK = "/usr/sbin/conntrack"
SS = "/usr/bin/ss"

# Each entry: verb -> (expected arg count, nft argv builder).
# The builder receives the helper's OWN argv (already validated) and
# returns the exact argv to pass to `nft` - no table/family/set name
# ever comes from the caller.
_QUARANTINE = ("inet", "filter", "quarantine")
_ENROLLED = ("ip", "nat", "enrolled")
_QUARANTINE_MAC = ("inet", "filter", "quarantine_mac")
_BLOCKED_IP = ("inet", "filter", "blocked_ip")

# Six colon-separated pairs of hex digits, and nothing else - the only
# shape nft's ether_addr type accepts, checked here so a malformed value
# never reaches nft at all.
_MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")


class RejectedInput(Exception):
    """Raised for anything that doesn't parse as what a verb expects.
    Never lets a malformed argument reach `nft` at all."""


def _require_ip(value, what="argument"):
    try:
        ipaddress.ip_address(value)
    except ValueError:
        raise RejectedInput("%s is not a valid IP address: %r" % (what, value))
    return value


def _require_hours(value):
    # 1-720 hours (1 hour to 30 days): generous enough for any real
    # enrollment length this console offers, narrow enough that a typo
    # or an injected huge number can't create a set element that
    # effectively never expires.
    if not value.isdigit() or not (1 <= int(value) <= 720):
        raise RejectedInput("hours must be a whole number from 1 to 720: %r" % value)
    return value


def _require_mac(value):
    if not _MAC_RE.match(value):
        raise RejectedInput("not a valid MAC address (expected aa:bb:cc:dd:ee:ff, lowercase): %r" % value)
    return value


def _require_ipv4(value):
    # The blocked_ip set is `type ipv4_addr`, so an IPv6 address would be
    # refused by nft anyway - rejecting it here gives a clearer message.
    try:
        ipaddress.IPv4Address(value)
    except ValueError:
        raise RejectedInput("not a valid IPv4 address: %r" % value)
    return value


def _require_seconds(value):
    # 60 seconds to 30 days - the same upper bound _require_hours uses, so
    # nothing this console asks for can create a set element that
    # effectively never expires by accident.
    if not value.isdigit() or not (60 <= int(value) <= 720 * 3600):
        raise RejectedInput("seconds must be a whole number from 60 to 2592000: %r" % value)
    return value


def _element(value, seconds):
    # With no timeout, the element stays until it's deleted.
    if seconds is None:
        return "{ %s }" % value
    return "{ %s timeout %ss }" % (value, seconds)


def build_nft_argv(verb, args):
    """Pure function: verb + already-split argv -> the exact nft argv to
    run, or raises RejectedInput. No subprocess call happens here, which
    is what makes this testable without root or a real nftables ruleset
    (see tests/test_securepi_web_helper.py)."""
    family, table, set_name = None, None, None

    if verb == "quarantine-add":
        if len(args) != 1:
            raise RejectedInput("quarantine-add takes exactly one argument (an IP)")
        ip = _require_ip(args[0])
        family, table, set_name = _QUARANTINE
        return ["add", "element", family, table, set_name, "{ %s }" % ip]

    if verb == "quarantine-delete":
        if len(args) != 1:
            raise RejectedInput("quarantine-delete takes exactly one argument (an IP)")
        ip = _require_ip(args[0])
        family, table, set_name = _QUARANTINE
        return ["delete", "element", family, table, set_name, "{ %s }" % ip]

    if verb == "quarantine-list":
        if len(args) != 0:
            raise RejectedInput("quarantine-list takes no arguments")
        family, table, set_name = _QUARANTINE
        return ["-j", "list", "set", family, table, set_name]

    if verb == "enrolled-add":
        if len(args) != 2:
            raise RejectedInput("enrolled-add takes exactly two arguments (an IP and a whole-number hour count)")
        ip = _require_ip(args[0])
        hours = _require_hours(args[1])
        family, table, set_name = _ENROLLED
        return ["add", "element", family, table, set_name, "{ %s timeout %sh }" % (ip, hours)]

    if verb == "enrolled-delete":
        if len(args) != 1:
            raise RejectedInput("enrolled-delete takes exactly one argument (an IP)")
        ip = _require_ip(args[0])
        family, table, set_name = _ENROLLED
        return ["delete", "element", family, table, set_name, "{ %s }" % ip]

    if verb == "enrolled-list":
        if len(args) != 0:
            raise RejectedInput("enrolled-list takes no arguments")
        family, table, set_name = _ENROLLED
        return ["-j", "list", "set", family, table, set_name]

    if verb == "enrolled-flush":
        if len(args) != 0:
            raise RejectedInput("enrolled-flush takes no arguments")
        family, table, set_name = _ENROLLED
        return ["flush", "set", family, table, set_name]

    if verb in ("quarantine-mac-add", "blocked-ip-add"):
        if len(args) not in (1, 2):
            raise RejectedInput("%s takes one or two arguments (an address, then optional seconds)" % verb)
        if verb == "quarantine-mac-add":
            value = _require_mac(args[0])
            family, table, set_name = _QUARANTINE_MAC
        else:
            value = _require_ipv4(args[0])
            family, table, set_name = _BLOCKED_IP
        seconds = _require_seconds(args[1]) if len(args) == 2 else None
        return ["add", "element", family, table, set_name, _element(value, seconds)]

    if verb in ("quarantine-mac-delete", "blocked-ip-delete"):
        if len(args) != 1:
            raise RejectedInput("%s takes exactly one argument (an address)" % verb)
        if verb == "quarantine-mac-delete":
            value = _require_mac(args[0])
            family, table, set_name = _QUARANTINE_MAC
        else:
            value = _require_ipv4(args[0])
            family, table, set_name = _BLOCKED_IP
        return ["delete", "element", family, table, set_name, "{ %s }" % value]

    if verb in ("quarantine-mac-list", "blocked-ip-list"):
        if len(args) != 0:
            raise RejectedInput("%s takes no arguments" % verb)
        family, table, set_name = _QUARANTINE_MAC if verb == "quarantine-mac-list" else _BLOCKED_IP
        return ["-j", "list", "set", family, table, set_name]

    raise RejectedInput("unknown verb: %r" % verb)


def build_reset_commands(verb, args):
    """Pure function, like build_nft_argv: the exact commands for an
    https-reset verb, or None if `verb` isn't one."""
    if verb == "https-reset":
        if len(args) != 1:
            raise RejectedInput("https-reset takes exactly one argument (an IP)")
        ip = _require_ipv4(args[0])
        return [[CONNTRACK, "-D", "-p", "tcp", "--orig-src", ip, "--orig-port-dst", "443"],
                [SS, "-K", "dst", ip, "sport", "=", ":8080"]]
    if verb == "https-reset-all":
        if len(args) != 0:
            raise RejectedInput("https-reset-all takes no arguments")
        return [[SS, "-K", "sport", "=", ":8080"]]
    return None


def run_reset(verb, commands):
    """Run each command; conntrack exits 1 when there was nothing to
    delete, which is not an error here."""
    syslog.syslog(syslog.LOG_INFO, "%s %s" % (verb, commands[0][5] if verb == "https-reset" else ""))
    for argv in commands:
        try:
            result = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired) as e:
            print("could not run %s: %s" % (argv[0], e), file=sys.stderr)
            return 1
        nothing = argv[0] == CONNTRACK and "0 flow entries" in result.stderr
        if result.returncode != 0 and not nothing:
            sys.stderr.write(result.stderr)
            return result.returncode
    return 0


def main(argv):
    syslog.openlog("securepi-web-helper", syslog.LOG_PID, syslog.LOG_AUTH)
    if not argv:
        print("usage: securepi-web-helper <verb> [args...]", file=sys.stderr)
        return 2
    verb, args = argv[0], argv[1:]
    try:
        reset = build_reset_commands(verb, args)
        if reset is not None:
            return run_reset(verb, reset)
        nft_argv = build_nft_argv(verb, args)
    except RejectedInput as e:
        syslog.syslog(syslog.LOG_WARNING, "REJECTED %s %s - %s" % (verb, args, e))
        print("REJECTED: %s" % e, file=sys.stderr)
        return 1

    # Changes are logged; the read-only *-list verbs are not. The
    # orchestrator (step 4.1) reads every set each 15-second cycle, and
    # logging those reads would bury the calls that actually changed the
    # firewall under thousands of identical lines a day. Rejected input
    # is always logged, above, whatever the verb.
    if not verb.endswith("-list"):
        syslog.syslog(syslog.LOG_INFO, "%s %s" % (verb, args))
    try:
        result = subprocess.run([NFT] + nft_argv, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        syslog.syslog(syslog.LOG_ERR, "could not run nft for %s: %s" % (verb, e))
        print("could not run nft: %s" % e, file=sys.stderr)
        return 1

    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
