[Unit]
Description=SecurePi Gateway - web console
After=securepi-ingest.service
Wants=securepi-ingest.service

[Service]
Type=simple
WorkingDirectory=/opt/securepi
# User/Group (step 3.3, finding G9): the console used to run as root
# (no User= line at all) purely so it could call `nft` for quarantine
# and Tier 2 enrollment. Those calls now go through
# gateway/securepi-web-helper via sudo instead (see
# gateway/securepi-web-sudoers), so this process itself needs no
# privilege of its own. Deliberately NOT setting NoNewPrivileges=true
# here, unlike a typical hardening checklist would suggest for an
# unprivileged service: that flag would block sudo itself (sudo relies
# on being able to gain privileges via its own setuid bit), which would
# silently break the one privileged path this service is still allowed
# to use.
User=securepi-web
Group=securepi
# --ssl-keyfile/--ssl-certfile (step 3.2): the console's own leaf
# certificate, generated by gateway/generate-console-tls.sh, signed by
# a CA that exists only for this console - separate from the CA
# dpi/deploy-dpi.sh generates for HTTPS inspection (see that script's
# own header for why). With these set, uvicorn only accepts a TLS
# handshake on this port - a plain HTTP request gets no response at
# all, not a redirect, which is what step 3.2's "HTTPS only" exit
# criterion asks for.
ExecStart=/usr/bin/python3 -m uvicorn webapp:app --host 10.10.0.1 --port 8000 \
    --ssl-keyfile /opt/securepi-tls/console.key \
    --ssl-certfile /opt/securepi-tls/console.crt
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
