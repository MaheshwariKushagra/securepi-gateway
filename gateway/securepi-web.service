[Unit]
Description=SecurePi Gateway - web console
After=securepi-ingest.service
Wants=securepi-ingest.service

[Service]
Type=simple
WorkingDirectory=/opt/securepi
# --ssl-keyfile/--ssl-certfile (step 3.2): the console's own leaf
# certificate, generated by gateway/generate-console-tls.sh, signed by
# a CA that exists only for this console - separate from the CA
# dpi/deploy-dpi.sh generates for HTTPS inspection (see that script's
# own header for why). With these set, uvicorn only accepts a TLS
# handshake on this port - a plain HTTP request gets no response at
# all, not a redirect, which is what step 3.2's "HTTPS only" exit
# criterion asks for.
ExecStart=/usr/bin/python3 -m uvicorn webapp:app --host 10.10.0.1 --port 8000 \
    --ssl-keyfile /opt/securepi-tls/console.key \
    --ssl-certfile /opt/securepi-tls/console.crt
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
