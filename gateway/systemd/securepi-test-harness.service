[Unit]
Description=SecurePi Gateway - isolated test-traffic harness (bridge + netns)
Before=suricata.service
DefaultDependencies=no
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/securepi/setup-test-harness.sh
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
